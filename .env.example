# Copie este arquivo para .env.local e preencha com os dados do projeto Supabase.
# A chave anon é pública por desenho. Nunca coloque a service_role key aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# No GitHub Pages de projeto, use /nome-do-repositorio/
# Em desenvolvimento local, deixe apenas /
VITE_BASE_PATH=/
